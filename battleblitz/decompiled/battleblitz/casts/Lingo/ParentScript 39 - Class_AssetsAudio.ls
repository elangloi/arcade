  preloadMember(SFX_LANDING_SMALL_PERSON)
  preloadMember(SFX_PUNCH_BLOCK)
  preloadMember(SFX_PUNCH_LANDING)
  preloadMember(SFX_PUNCH_WOOSH)
  preloadMember(SFX_SLUMP_TO_FLOOR)
  preloadMember(SFX_SUMMON_TITAN)
  preloadMember(SFX_TIME_WARNING)
  preloadMember(SFX_TITLES_FIGHT)
  preloadMember(SFX_TITLES_KO)
  preloadMember(SFX_TITLES_ROUND)
  preloadMember(SFX_WALKING_BIG_PERSON_1)
  preloadMember(SFX_WALKING_BIG_PERSON_2)
  preloadMember(SFX_WALKING_MEDIUM_PERSON_1)
  preloadMember(SFX_WALKING_MEDIUM_PERSON_2)
  preloadMember(SFX_WALKING_SMALL_PERSON_1)
  preloadMember(SFX_WALKING_SMALL_PERSON_2)
  preloadMember(SFX_WALL_SLAM)
end
