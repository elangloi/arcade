# Copy to compose/.env (git-ignored; deploy.sh syncs it to the server).
#
# Publish the arcade to the internet through Tailscale Funnel: https://arcade.<tailnet>.ts.net/
#   1. https://login.tailscale.com/admin/settings/keys -> Generate auth key (reusable, no expiry is fine
#      for a home box; tag it if you use tags).
#   2. https://login.tailscale.com/admin/dns -> enable HTTPS certificates.
#   3. https://login.tailscale.com/admin/acls -> add the funnel node attribute (the console offers a
#      one-click "Enable Funnel" the first time a node tries; otherwise:
#        "nodeAttrs": [{ "target": ["autogroup:member"], "attr": ["funnel"] }]
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
COMPOSE_PROFILES=public

# Port the proxy publishes on the LAN (default 80).
# ARCADE_HTTP_PORT=80
# Battle Blitz 2P health tier, 1..3.
# MP_DIFFICULTY=1
